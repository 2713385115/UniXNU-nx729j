diff --git a/pexpert/arm/pe_init.c b/pexpert/arm/pe_init.c
index 433b6cd..9c2f080 100644
--- a/pexpert/arm/pe_init.c
+++ b/pexpert/arm/pe_init.c
@@ -73,6 +73,9 @@ clock_frequency_info_t gPEClockFrequencyInfo;
 vm_offset_t gPanicBase = 0;
 unsigned int gPanicSize;
 struct embedded_panic_header *panic_info = NULL;
+#if defined(XNU_NX729J_VOLATILE_PANIC_LOG) && XNU_NX729J_VOLATILE_PANIC_LOG
+static uint8_t nx729j_volatile_panic_log[128 * 1024] __attribute__((aligned(4096)));
+#endif
 
 #if (DEVELOPMENT || DEBUG) && defined(XNU_TARGET_OS_BRIDGE)
 /*
@@ -102,7 +105,19 @@ void PE_slide_devicetree(vm_offset_t);
 static void
 check_for_panic_log(void)
 {
-#ifdef PLATFORM_PANIC_LOG_PADDR
+#if defined(XNU_NX729J_VOLATILE_PANIC_LOG) && XNU_NX729J_VOLATILE_PANIC_LOG
+	/*
+	 * The nx729j device tree has no Apple PRAM reservation, so the standard
+	 * embedded panic machinery would silently drop every panic.  Keep it valid
+	 * with kernel-owned RAM instead; the contents are intentionally volatile and
+	 * never advertised to firmware as persistent.  The *persistent* record is the
+	 * ramoops console mirror in nx729j_ramoops_console.h, which already captured
+	 * the console output (including the panic backtrace) before it happened.
+	 */
+	gPanicBase = (vm_offset_t)nx729j_volatile_panic_log;
+	gPanicSize = sizeof(nx729j_volatile_panic_log);
+	panic_text_len = gPanicSize - sizeof(struct embedded_panic_header);
+#elif defined(PLATFORM_PANIC_LOG_PADDR)
 	gPanicBase = ml_io_map_wcomb(PLATFORM_PANIC_LOG_PADDR, PLATFORM_PANIC_LOG_SIZE);
 	panic_text_len = PLATFORM_PANIC_LOG_SIZE - sizeof(struct embedded_panic_header);
 	gPanicSize = PLATFORM_PANIC_LOG_SIZE;
