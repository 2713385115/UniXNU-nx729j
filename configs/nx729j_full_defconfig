# Kernel configuration of the nx729j image: UFS root with a powered controller.
#
# The official terminal configuration (nx729j_defconfig) cannot be linked in this tree.
# Three of its components name archives that no board.toml entry builds, and the
# dependency checks in scripts/build-xnu-4k-baseline.sh then refuse the combination:
#
#   NATIVE_VIRTIO_BLOCK    no builder (needs build/storage-abi/interface-audit.json, a
#                          live lldb snapshot of bsd_init)
#   VERIFIED_ROOT_PROBE    no builder (needs build/verified-root-os/verification.json and
#                          the 6 GB original target volume; the workflow prepares neither)
#   NATIVE_LEGACY_DISPLAY /
#   NATIVE_ADRENO          builders withheld from this fork
#
#   OWNER_ROOT_AUDIT=1  requires VERIFIED_ROOT_PROBE=1        (line 257 of that script)
#   OWNER_ROOT_TRUST=1  requires OWNER_ROOT_AUDIT=1 AND NATIVE_VIRTIO_BLOCK=1  (line 266)
#
# So the owner mount chain is not reachable here by construction; it is not a choice.
# What is reachable, and what this file selects, is the storage half:
#
#   NATIVE_UFS             the whole point: host bring-up, GPT, root windows, and the
#                          verified-block policy path (board.toml links NativeUfs with
#                          -DNATIVE_VERIFIED_BLOCK=1)
#   SHENG_PMGR             off: needs libShengPlatformPower.a, and no board.toml entry
#                          builds it (kits/sheng/ShengPlatformPower.cpp is not in any
#                          published repository). The UFS controller keep-alive is
#                          approximated by the image-side binary patch instead.
#   (old note)             the UFS controller's clocks and power. nx729j_ufs_defconfig
#                          leaves this off, which is why that image wrote nothing at all
#                          to the log window: without it hostBringUp cannot talk to the
#                          controller, so no record can even be attempted.
#   NATIVE_RAM_BLOCK       off: it publishes the packed-Data seed as a 32 MiB media
#                          (8192 x 4096) and registers it before the UFS windows, so it
#                          becomes disk0 and APFS mounts THAT container. mountroot then
#                          waits forever for the OS UUID, which is exactly what the
#                          u097 log shows: dev_init disk0 4096/8192, nx_mount disk0
#                          "checkpoint search: largest xid 5", then Waiting on UUID.
#                          nx729j_ufs/storage_defconfig also leave it off.
#   BOOT_PROGRESS          off: line 65 of build-xnu-4k-baseline.sh requires
#                          OWNER_ROOT_AUDIT and NATIVE_VIRTIO_BLOCK alongside it, and both
#                          are unreachable here. The stub archive alone is not enough.
#   ramoops + panic region so a stop leaves text somewhere other than a black screen
#
# Display and GPU stay off: their builders are withheld, and at this stage the screen is
# not the instrument -- the 32 MiB UFS window is.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_NATIVE_RAM_BLOCK=n
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_SHENG_PMGR=n
CONFIG_XNU_BOOT_PROGRESS=n
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="18AB5557-DC2D-469B-8758-855E60F5B0DF"
CONFIG_XNU_VERIFIED_ROOT_ARCHIVE="{tree}/build/verified-root-bundle/libVerifiedRootBundle.a"
CONFIG_XNU_EXTRA_LD_ARCHIVES=""

CONFIG_XNU_VERIFIED_ROOT_PROBE=n
CONFIG_XNU_OWNER_ROOT_AUDIT=n
CONFIG_XNU_OWNER_ROOT_TRUST=n
CONFIG_XNU_OWNER_CACHE_MOUNT=n
CONFIG_XNU_OWNER_CACHE_STARTUP=n
CONFIG_XNU_OWNER_BOOT_MANIFEST=n
CONFIG_XNU_OWNER_DATA_MOUNT=n
CONFIG_XNU_OWNER_UNION_SYSTEMOS=n
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_VIRTIO_CONSOLE=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_NATIVE_OFFLINE_GPU=n
CONFIG_XNU_SOURCE_MOCKFS=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=n
CONFIG_XNU_NATIVE_VIRTIO_BLOCK_ARCHIVE=""

# Persistent console mirror (ramoops) into the PIL Reserved carve-out at 0x8A800000.
CONFIG_XNU_NX729J_RAMOOPS_CONSOLE=y
CONFIG_XNU_NX729J_VOLATILE_PANIC_LOG=y
