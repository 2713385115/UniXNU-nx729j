# Kernel configuration of the nx729j image: the largest owner-root chain this tree
# can actually link.
#
# This is nx729j_defconfig with four components off. None of them is a preference:
# each one names an archive that board.toml never builds, so the kernel link fails
# with "no builder makes it, supply the archive" before any of our code is reached.
#
#   NATIVE_VIRTIO_BLOCK    build/native-virtio-block-verified-bundle/libNativeVirtioBlock.a
#                          has no builder: its binding needs
#                          build/storage-abi/interface-audit.json, a live lldb snapshot
#                          of bsd_init. This board has no virtio transport; the UFS root
#                          windows are the block devices, so runtime loses nothing.
#   VERIFIED_ROOT_PROBE    bsd_init's crypto probe calls native_verified_root_probe(),
#                          provided only by build-verified-root-probe.py, which requires
#                          build/verified-root-os/verification.json and the 6 GB original
#                          target volume. The CI workflow prepares neither. The owner
#                          mount chain does not go through this probe.
#   NATIVE_LEGACY_DISPLAY  build-native-legacy-display.py is withheld from this fork.
#   NATIVE_ADRENO          build-arm-driver.py NativeAdreno, build-native-adreno-kits.py
#                          and build-native-adreno-accelerator.py are all withheld.
#
# Everything that does link stays on: NATIVE_RAM_BLOCK, the OWNER_* mount chain
# (root audit, root trust, cache mount, cache startup, boot manifest, data mount,
# union SystemOS), SHENG_PMGR, BOOT_PROGRESS, the ramoops console and the panic region.
# That is the shape of the kernel whose UFS window last recorded
# "stage=policy header read failed": native_ram_block 22 symbols, native_owner 80
# symbols, virtio 0, verified_root 11.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
# PMGR integration lives in the sheng kit; RPMh / AOSS addresses are SoC level.
CONFIG_XNU_SHENG_PMGR=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_BOOT_PROGRESS=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# Scratch Data volume identity. It is arbitrary but must match the Data seed the
# payload step embeds; kept at the sheng value because the seed tooling comes from
# the sheng kit. Change it only together with the seed.
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="18AB5557-DC2D-469B-8758-855E60F5B0DF"
CONFIG_XNU_VERIFIED_ROOT_ARCHIVE="{tree}/build/verified-root-bundle/libVerifiedRootBundle.a"
CONFIG_XNU_NATIVE_VIRTIO_BLOCK_ARCHIVE=""
CONFIG_XNU_EXTRA_LD_ARCHIVES=""
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_VIRTIO_CONSOLE=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_VERIFIED_ROOT_PROBE=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_NATIVE_OFFLINE_GPU=n

# Persistent console mirror (ramoops) into the PIL Reserved carve-out at 0x8A800000.
# After a crash the bootloader / 9008 QFIL reads the 2 MiB window back from physical memory.
CONFIG_XNU_NX729J_RAMOOPS_CONSOLE=y
CONFIG_XNU_NX729J_VOLATILE_PANIC_LOG=y
