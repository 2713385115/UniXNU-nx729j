# Kernel configuration of the nx729j UFS probe image (stage 6, first look).
# CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.
#
# This is nx729j_bringup_defconfig plus exactly one component: the native UFS
# transport. It exists to answer one question that needs hardware and nothing
# else: can this kernel reach the SM8550 UFS host controller and read the GPT
# of LUN 0? `native-ufs-probe=10` performs that read-only check and then panics
# with the result, so the boot page shows it without a serial port.
#
# What is deliberately still off, and why:
#
#   NATIVE_VIRTIO_BLOCK   no virtio transport on this board, and its binding
#                         needs build/storage-abi/interface-audit.json, which
#                         only a live lldb snapshot of bsd_init can produce
#   NATIVE_RAM_BLOCK      same storage audit
#   VERIFIED_ROOT_PROBE   libVerifiedRootProbe.a needs
#                         build/verified-root-os/verification.json, i.e. the
#                         full original OS image and its C signature pass
#   OWNER_*               the original-userland mount chain; needs the above
#   SHENG_PMGR            build/sheng-platform-power/libShengPlatformPower.a
#                         needs kits/sheng/ShengPlatformPower.cpp, which no
#                         published repository contains; the equivalent effect
#                         (skip AMFI's AON latch) is applied as a binary patch
#   NATIVE_LEGACY_DISPLAY / NATIVE_ADRENO
#                         need an exact original framebuffer/GPU candidate
#   SOURCE_MOCKFS         a QEMU test fixture, not a device component
#   BOOT_PROGRESS         reports checkpoints generated by NATIVE_VIRTIO_BLOCK
#                         and OWNER_ROOT_AUDIT, neither of which is on here
#
# NativeUfs normally compiles with -DNATIVE_VERIFIED_BLOCK=1, which drags in
# vr_open/vr_verify_block/vr_xnu_crypto/verified_root_key from the VerifiedRoot
# kit. The archive line in board.toml passes --no-verified-block for this stage:
# the raw host bring-up, the command queue and hostRead4k are untouched, only
# the per-read signature check is not linked. Once a verified original image
# exists, that flag comes off and the same driver runs the verified path.

# NativeUfs compiles with -DNATIVE_VERIFIED_BLOCK=1, exactly like the qualified
# configuration, so the driver's read path is the real one. Before an original
# image has been verified there is no VerifiedRoot archive to link against, so
# scripts/build-verified-root-stub.py supplies refusing placeholders and
# CONFIG_XNU_EXTRA_LD_ARCHIVES links them. Its policy count is zero, so
# NativeUfsBlock::configureVerification() refuses immediately and the verified
# block device is never published; the raw transport used by native-ufs-probe
# is unaffected.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_EXTRA_LD_ARCHIVES="{tree}/build/verified-root-stub/libVerifiedRootStub.a"

CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_RAM_BLOCK=n
CONFIG_XNU_NATIVE_VIRTIO_CONSOLE=n
CONFIG_XNU_NATIVE_OFFLINE_GPU=n
CONFIG_XNU_SHENG_PMGR=n
CONFIG_XNU_SOURCE_MOCKFS=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=n
CONFIG_XNU_VERIFIED_ROOT_PROBE=n
CONFIG_XNU_OWNER_ROOT_AUDIT=n
CONFIG_XNU_OWNER_ROOT_TRUST=n
CONFIG_XNU_OWNER_CACHE_MOUNT=n
CONFIG_XNU_OWNER_CACHE_STARTUP=n
CONFIG_XNU_OWNER_BOOT_MANIFEST=n
CONFIG_XNU_OWNER_DATA_MOUNT=n
CONFIG_XNU_OWNER_UNION_SYSTEMOS=n
CONFIG_XNU_BOOT_PROGRESS=n

CONFIG_XNU_OWNER_DATA_VOLUME_UUID="00000000-0000-0000-0000-000000000000"
